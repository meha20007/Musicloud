# ============================================================
#  Copy this file → .env  and fill in your real Supabase values
#  NEVER commit the real .env to GitHub!
# ============================================================

# Supabase Project URL (find it in Supabase → Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public Key (safe to share in frontend)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (KEEP SECRET — backend only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase JWT Secret (Supabase → Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# PostgreSQL connection (Supabase → Settings → Database → Connection string)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-project-id.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-supabase-database-password

# Optional: storage bucket names (defaults shown)
SUPABASE_SONGS_BUCKET=songs
SUPABASE_COVERS_BUCKET=covers

# Token expiry: 86400000 ms = 24 hours
JWT_EXPIRATION_MS=86400000
